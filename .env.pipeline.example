# sentinelCam-worker — Pipeline-Mode environment.
# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.pipeline.example .env
# Then start with:
#   docker compose -f docker-compose.pipeline.yml up -d --build

# --- REQUIRED ----------------------------------------------------------------
# Public (or VPN) URL of your sentinelCam-web instance. Must be https://.
WEB_URL=https://sentinelcam.example.com

# Worker token issued via the web admin UI (Workers -> New worker).
# Format: sc-wrk-<id>-<32hex>. Shown exactly once — store it here, chmod 600.
WEB_TOKEN=sc-wrk-1-CHANGEME

# Informational name shown in the admin panel.
WORKER_NAME=prod-worker-01

# --- LIVE VIDEO (H.264) -----------------------------------------------------
# The worker GPU-encodes each processed frame to H.264 for the low-latency live
# view; the web server relays it as fragmented-MP4 with no re-encode. Set
# WORKER_H264=0 to disable the lane (the web then serves MJPEG only).
# NOTE: PyAV's prebuilt wheels bundle an ffmpeg WITHOUT NVENC, so you get
# libx264 (CPU) unless PyAV is built against an NVENC-enabled ffmpeg.
WORKER_H264=1
WORKER_VIDEO_FPS=30
WORKER_H264_BITRATE_KBPS=4000
WORKER_H264_GOP_SECONDS=2.0
# JPEG lane (snapshots / clips / MJPEG fallback). 0 = every frame (smoothest
# clips); set e.g. 5 to send fewer JPEGs and save internal bandwidth.
WORKER_PROCESSED_JPEG_FPS=0

# --- IMAGE QUALITY ----------------------------------------------------------
# JPEG quality for the snapshot/clip/MJPEG lane.
JPEG_QUALITY=88

# --- YOLO INFERENCE ---------------------------------------------------------
# Set WORKER_YOLO_MODEL to enable real detection. Without it the worker runs
# the stub overlay and no auto-recording detections are emitted.
WORKER_YOLO_MODEL=yolov8n.pt
WORKER_YOLO_POSE_MODEL=yolov8n-pose.pt
WORKER_YOLO_CONF=0.35
WORKER_YOLO_IOU=0.5
WORKER_YOLO_IMGSZ=640
# Optional COCO class allow-list to cut clutter / false auto-record triggers,
# e.g. "0" for person-only or "0,15,16" (person, cat, dog). Empty = all classes.
WORKER_YOLO_CLASSES=
WORKER_YOLO_MAX_DET=100
# Empty = auto (cuda > mps > cpu). Pin to cuda:0 in production.
WORKER_YOLO_DEVICE=cuda:0
# FP16 — leave on for NVIDIA GPUs, set to 0 for CPU builds.
WORKER_YOLO_HALF=1

# --- TLS --------------------------------------------------------------------
# Set to 0 to disable certificate verification.
# DANGER: only use as a temporary workaround (e.g. while waiting for a real
# certificate to be issued). Encryption stays on but the connection becomes
# vulnerable to MITM. Set back to 1 (or remove the line) as soon as a trusted
# certificate is installed on the web server.
WEB_TLS_VERIFY=1

# --- LOGGING ----------------------------------------------------------------
LOG_LEVEL=INFO
