# sentinelCam-worker — Pipeline-Mode environment.
# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.pipeline.example .env
# Then start with:
#   docker compose -f docker-compose.pipeline.yml up -d --build

# --- REQUIRED ----------------------------------------------------------------
# URL of your sentinelCam-web instance (https://).
#  - Direct (recommended): the web server's INTERNAL hostname, which must be
#    listed in Traefik's router rule (traefik/dynamic/routes.yml). The worker
#    reaches it over your LAN/network DNS, bypassing Cloudflare entirely.
#  - Via Cloudflare: https://sentinelcam.ch (only if you cannot reach it directly).
WEB_URL=https://ie-lis050

# Worker token issued via the web admin UI (Workers -> New worker).
# Format: sc-wrk-<id>-<32hex>. Shown exactly once — store it here, chmod 600.
WEB_TOKEN=sc-wrk-1-CHANGEME

# Informational name shown in the admin panel.
WORKER_NAME=prod-worker-01

# --- LIVE VIDEO (H.264) -----------------------------------------------------
# The worker GPU-encodes each processed frame to H.264 for the low-latency live
# view; the web server relays it as fragmented-MP4 with no re-encode. Set
# WORKER_H264=0 to disable the lane (the web then serves MJPEG only).
# NOTE: PyAV's prebuilt wheels bundle an ffmpeg WITHOUT NVENC, so you get
# libx264 (CPU) unless PyAV is built against an NVENC-enabled ffmpeg.
WORKER_H264=1
WORKER_VIDEO_FPS=30
# Match the source resolution: ~720p=4000, 1080p=8000, 1440p=12000 kbps.
WORKER_H264_BITRATE_KBPS=8000
WORKER_H264_GOP_SECONDS=2.0
# JPEG lane (snapshots / clips / MJPEG fallback). H.264 now carries the live
# view, so the JPEG lane only needs the web's clip rate (CLIP_FPS=15) — that
# keeps clips natural and avoids redundant upstream bandwidth. 0 = every frame.
WORKER_PROCESSED_JPEG_FPS=15

# --- IMAGE QUALITY ----------------------------------------------------------
# JPEG quality for the snapshot/clip/MJPEG lane.
JPEG_QUALITY=88

# --- YOLO INFERENCE ---------------------------------------------------------
# Set WORKER_YOLO_MODEL to enable real detection. Without it the worker runs
# the stub overlay and no auto-recording detections are emitted.
WORKER_YOLO_MODEL=yolov8n.pt
WORKER_YOLO_POSE_MODEL=yolov8n-pose.pt
WORKER_YOLO_CONF=0.35
WORKER_YOLO_IOU=0.5
# 640 = fast; 960/1280 give better detection on 1080p. A strong GPU (e.g. H200)
# handles 960+ easily.
WORKER_YOLO_IMGSZ=960
# Optional COCO class allow-list to cut clutter / false auto-record triggers,
# e.g. "0" for person-only or "0,15,16" (person, cat, dog). Empty = all classes.
WORKER_YOLO_CLASSES=
WORKER_YOLO_MAX_DET=100
# Empty = auto (cuda > mps > cpu). Pin to cuda:0 in production.
WORKER_YOLO_DEVICE=cuda:0
# FP16 — leave on for NVIDIA GPUs, set to 0 for CPU builds.
WORKER_YOLO_HALF=1

# --- CONNECTION TO WEB ------------------------------------------------------
# Do NOT route the worker through Cloudflare: it is unreliable for sustained
# high-throughput WebSockets (periodic "keepalive ping timeout" -> the live view
# freezes) and would also see every frame. Connect directly (LAN) via WEB_URL
# above. The Cloudflare Origin cert isn't trusted off-Cloudflare, so turn
# verification off — the LAN/VPN already encrypts + authenticates the link:
WEB_TLS_VERIFY=0
#
# Fallback ONLY if this container cannot resolve WEB_URL's hostname via DNS:
# set WEB_URL=https://sentinelcam.ch, uncomment the extra_hosts block in
# docker-compose.pipeline.yml, and pin the IP here:
#   WEB_HOSTNAME=sentinelcam.ch
#   WEB_DIRECT_IP=<web server IP>      # LAN IP of the web host (or 172.30.0.10 via VPN)

# --- LOGGING ----------------------------------------------------------------
LOG_LEVEL=INFO
