# sentinelCam-worker — Standalone-Mode environment.
# Copy to .env and fill in the values you need.
#   cp .env.standalone.example .env
# Then start with:
#   docker compose -f docker-compose.worker.yml up -d --build
# Linux + USB-Webcam:
#   docker compose -f docker-compose.worker.yml -f docker-compose.worker-cam.yml up -d --build

# --- AUTH -------------------------------------------------------------------
# Long random string. Browsers/clients must send
#   Authorization: Bearer <token>
# Leave empty only on strictly trusted networks.
WORKER_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to talk to the worker HTTP API.
WORKER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- CAMERA SOURCE ----------------------------------------------------------
# testsrc  -> synthetic test pattern (no hardware needed)
# 0        -> /dev/video0 (use with docker-compose.worker-cam.yml)
# /dev/videoN -> explicit device path
WORKER_SOURCE=testsrc

# Linux passthrough: which device to mount when using the worker-cam override.
WORKER_VIDEO_DEVICE=/dev/video0
